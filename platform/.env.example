# Cleanse.ng platform environment (Blueprint §17.2)
# Copy to .env.local for local development. NEVER commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Full-access service role. Must NEVER reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (server-only secret + public key) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET_MODE=HMAC_SHA512

# --- Firebase Cloud Messaging (Stage 5, not required for Stages 0-2) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- SMS fallback (Stage 8) ---
SMS_PROVIDER=bulksmsnigeria
BULKSMSNIGERIA_API_TOKEN=
SMS_SENDER_ID=CLEANSE
SMS_DELIVERY_CALLBACK_SECRET=

# --- Inngest durable jobs (Stage 7) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Observability ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Dispatch policy (configurable pilot defaults, Blueprint §10.2) ---
DISPATCH_ROUND_1_SIZE=5
DISPATCH_PUSH_GRACE_SECONDS=60
DISPATCH_ROUND_2_AFTER_SECONDS=120
DISPATCH_ROUND_2_SIZE=10
DISPATCH_OFFER_TTL_SECONDS=300
DISPATCH_ESCALATION_SECONDS=300

# --- Other tunables (config-driven, no deploy needed) ---
QUOTE_TTL_SECONDS=600
CLEANER_PAYOUT_BPS=6000        # offer earnings DISPLAY only (not a pay promise)
SMS_UNIT_COST_KOBO=0           # per-segment estimate for SMS cost reporting
SHARE_CARD_TTL_HOURS=24        # cleaner card lifetime after scheduled service

# --- Hardening (Stage 11) ---
ADMIN_MFA_REQUIRED=false       # set true in production once admins enroll MFA
